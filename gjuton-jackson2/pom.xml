<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.gjuton</groupId>
        <artifactId>gjuton-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>gjuton-jackson2</artifactId>

    <name>Gjuton Jackson 2</name>
    <description>Binds gjuton to Jackson 2. Add this to a project on com.fasterxml.jackson.core:jackson-databind.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.gjuton</groupId>
            <artifactId>gjuton-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- The suite is compiled in gjuton-tests and run once per flavour. Test-scoped
             dependencies are not inherited, so everything it compiles against is named
             again here, on Jackson 2. -->
        <dependency>
            <groupId>io.github.gjuton</groupId>
            <artifactId>gjuton-tests</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- OpenApiIntegrationTest lives here rather than in gjuton-tests because it reads
             its corpus with Jackson's YAML mapper, and Jackson 3 configures that mapper
             through a different YAML engine. A test that names one major belongs with it. -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>${project.basedir}/src/test/resources</directory>
            </testResource>
            <!-- The schema corpus is read as files rather than as classpath streams, so it
                 is copied from gjuton-tests' sources instead of taken from its test-jar. -->
            <testResource>
                <directory>${project.basedir}/../gjuton-tests/src/test/resources</directory>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Surefire only discovers tests compiled in the module it runs, so the
                         suite coming from gjuton-tests has to be pointed at explicitly. -->
                    <dependenciesToScan>
                        <dependency>io.github.gjuton:gjuton-tests</dependency>
                    </dependenciesToScan>
                    <!-- ArchUnit tells test classes from production ones by their output
                         directory, so the layering rules only hold where the suite is
                         compiled. They run in gjuton-tests and nowhere else. -->
                    <excludes>
                        <exclude>**/ArchitectureTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.25.4</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.3</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <!-- The suite that exercises gjuton-core arrives as a jar, and the
                                 code it covers sits in another reactor module. crossModule makes
                                 pitest mutate those modules rather than this one alone. -->
                            <crossModule>true</crossModule>
                            <targetClasses>
                                <param>io.github.gjuton.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>io.github.gjuton.*</param>
                            </targetTests>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                        </configuration>
                        <executions>
                            <execution>
                                <phase>test</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
