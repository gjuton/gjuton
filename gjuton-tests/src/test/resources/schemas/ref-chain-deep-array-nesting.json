{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "minItems": 1,
    "maxItems": 2,
    "items": {"$ref": "#/$defs/Middle"},
    "$defs": {
        "Middle": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {"$ref": "#/$defs/Inner"}
        },
        "Inner": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {"type": "integer"}
        }
    }
}
