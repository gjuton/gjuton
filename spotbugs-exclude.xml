<FindBugsFilter>
    <!-- EI_EXPOSE_REP on GeneratorContext.random() is intentional and suppressed. -->
    <Match>
        <Class name="io.github.gjuton.internal.generator.GeneratorContext"/>
        <Method name="random"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <!-- The mapper is configured by the extension that constructs the converter and
         handed over for good; copying it would discard that configuration's point. -->
    <Match>
        <Or>
            <Class name="io.github.gjuton.internal.jackson2.conversion.Jackson2JsonConverter"/>
            <Class name="io.github.gjuton.internal.jackson3.conversion.Jackson3JsonConverter"/>
        </Or>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- The parser holds the converter it was handed; a converter is a shared
         service, not state to copy. -->
    <Match>
        <Class name="io.github.gjuton.internal.parser.SchemaParser"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Schema is sealed and effectively immutable: fields are set only during
         Jackson deserialization (via @JsonSetter with List.copyOf) or Lombok
         builder construction (internal code, always passes safe lists). -->
    <Match>
        <Class name="io.github.gjuton.internal.model.SchemaDocument"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- Conditional is a plain record over Schema references; same
         effectively-immutable rationale as above, but records don't get
         Lombok's @lombok.Generated pass on their accessors. -->
    <Match>
        <Class name="io.github.gjuton.internal.model.Schema$Conditional"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- StringFormatGenerator is abstract and package-private; all subclasses are final.
         No finalizer attack surface exists. -->
    <Match>
        <Class name="io.github.gjuton.internal.generator.format.StringFormatGenerator"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
</FindBugsFilter>
