<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.gjuton</groupId>
        <artifactId>gjuton-parent</artifactId>
        <version>0.1.1-SNAPSHOT</version>
    </parent>

    <artifactId>gjuton-jackson3</artifactId>

    <name>Gjuton Jackson 3</name>
    <description>Binds gjuton to Jackson 3. Add this to a project on tools.jackson.core:jackson-databind.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.gjuton</groupId>
            <artifactId>gjuton-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- The suite lives in gjuton-tests and runs there under Jackson 2; it is re-run
             here to show that Jackson 3 answers the same. gjuton-tests' own dependencies
             are test-scoped and so not inherited, which is what keeps its Jackson 2
             extension out of this classpath — but it also means everything the suite
             compiles against has to be named again below, on Jackson 3. -->
        <dependency>
            <groupId>io.github.gjuton</groupId>
            <artifactId>gjuton-tests</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The 3.x line of the schema validator, which is the 2.x the suite compiles
             against with Jackson 3 substituted in. The suite names none of the methods
             that differ, so the same test-jar runs against either. -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${networknt3.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <!-- The schema corpus is read as files rather than as classpath streams, so it
                 is copied from gjuton-tests' sources instead of taken from its test-jar. -->
            <testResource>
                <directory>${project.basedir}/../gjuton-tests/src/test/resources</directory>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Surefire only discovers tests compiled in the module it runs, so the
                         suite coming from gjuton-tests has to be pointed at explicitly. -->
                    <dependenciesToScan>
                        <dependency>io.github.gjuton:gjuton-tests</dependency>
                    </dependenciesToScan>
                    <!-- ArchUnit tells test classes from production ones by their output
                         directory, so the layering rules only hold where the suite is
                         compiled. They run in gjuton-tests and nowhere else. -->
                    <excludes>
                        <exclude>**/ArchitectureTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
