<configuration>

    <!--
      Generator tracing is off by default. Turn it on for a run with -Dgjuton.log.level=trace.
    -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%-5level %logger{0} [%mdc] - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="io.github.gjuton" level="${gjuton.log.level:-INFO}"/>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>
